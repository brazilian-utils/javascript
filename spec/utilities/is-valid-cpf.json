{
	"$schema": "../schema/utility.schema.json",
	"id": "is-valid-cpf",
	"kind": "validator",
	"summary": "Validates a CPF (Cadastro de Pessoas Físicas) number.",
	"sources": [
		{
			"role": "official",
			"url": "https://www.gov.br/receitafederal/pt-br/assuntos/meu-cpf"
		},
		{
			"role": "official",
			"url": "https://normas.receita.fazenda.gov.br/sijut2consulta/link.action?idAto=151372"
		}
	],
	"names": {
		"typescript": {
			"module": "is-valid-cpf",
			"function": "isValidCpf"
		},
		"python": {
			"module": "brutils.cpf",
			"function": "is_valid"
		},
		"go": {
			"module": "cpf",
			"function": "IsValid"
		},
		"ruby": {
			"module": "BrazilianUtils::CPFUtils",
			"function": "valid?"
		},
		"rust": {
			"module": "cpf",
			"function": "is_valid"
		},
		"java": {
			"module": "Cpf",
			"function": "isValid"
		}
	},
	"input": {
		"name": "cpf",
		"type": "string",
		"onWrongType": "false"
	},
	"output": {
		"type": "boolean"
	},
	"adopted": {
		"typescript": {
			"profile": "masked-strict"
		},
		"python": {
			"profile": "digits-only",
			"knownDeviations": [
				{
					"inputs": ["１２３４５６７８９０９", "١٢٣٤٥٦٧٨٩٠٩"],
					"reason": "brutils/cpf.py gates on str.isdigit(), which is Unicode aware, so a CPF written in full width or Arabic-Indic digits validates. The profile is ASCII only."
				}
			]
		},
		"ruby": {
			"profile": "digits-only"
		},
		"rust": {
			"profile": "digits-only"
		},
		"erlang": {
			"profile": "digits-only"
		},
		"go": {
			"profile": "digits-extracted"
		},
		"java": {
			"profile": "masked-strict"
		}
	},
	"profiles": {
		"masked-strict": {
			"description": "Accepts the usual mask characters and whitespace around and between the digit groups, and rejects every other shape. Implemented by the JavaScript package.",
			"pipeline": [
				{
					"op": "guard-shape",
					"target": "raw",
					"trim": "js-whitespace",
					"groups": [3, 3, 3, 2],
					"separators": "mask-cpf"
				},
				{
					"op": "sanitize",
					"keep": "ascii-digits",
					"into": "digits"
				},
				{
					"op": "guard-repeated",
					"target": "digits"
				},
				{
					"op": "verify-check-digits",
					"target": "digits",
					"checkDigit": "cpf"
				}
			]
		},
		"digits-only": {
			"description": "Accepts exactly 11 ASCII digits and nothing else. Implemented by the Python, Ruby, Rust and Erlang packages.",
			"pipeline": [
				{
					"op": "guard-shape",
					"target": "raw",
					"groups": [11]
				},
				{
					"op": "sanitize",
					"keep": "ascii-digits",
					"into": "digits"
				},
				{
					"op": "guard-repeated",
					"target": "digits"
				},
				{
					"op": "verify-check-digits",
					"target": "digits",
					"checkDigit": "cpf"
				}
			]
		},
		"digits-extracted": {
			"description": "Drops every non-digit character wherever it appears and validates what is left, so \"abc12345678909\" is accepted. Implemented by the Go package.",
			"pipeline": [
				{
					"op": "sanitize",
					"keep": "ascii-digits",
					"into": "digits"
				},
				{
					"op": "guard-length",
					"target": "digits",
					"equals": 11
				},
				{
					"op": "guard-repeated",
					"target": "digits"
				},
				{
					"op": "verify-check-digits",
					"target": "digits",
					"checkDigit": "cpf"
				}
			]
		}
	}
}
