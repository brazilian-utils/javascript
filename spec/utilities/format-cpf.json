{
	"$schema": "../schema/utility.schema.json",
	"id": "format-cpf",
	"kind": "formatter",
	"summary": "Formats a CPF value as \"000.000.000-00\".",
	"sources": [
		{
			"role": "official",
			"url": "https://www.gov.br/receitafederal/pt-br/assuntos/meu-cpf"
		}
	],
	"names": {
		"typescript": {
			"module": "format-cpf",
			"function": "formatCpf"
		},
		"python": {
			"module": "brutils.cpf",
			"function": "format_cpf"
		},
		"go": {
			"module": "cpf",
			"function": "Format"
		},
		"ruby": {
			"module": "BrazilianUtils::CPFUtils",
			"function": "format_cpf"
		},
		"rust": {
			"module": "cpf",
			"function": "format_cpf"
		},
		"java": {
			"module": "Cpf",
			"function": "format"
		}
	},
	"input": {
		"name": "value",
		"type": "string|number",
		"onNullish": "empty-string"
	},
	"output": {
		"type": "string"
	},
	"adopted": {
		"typescript": {
			"profile": "pattern-partial",
			"options": ["pad", "obfuscate"]
		},
		"go": {
			"profile": "pattern-partial",
			"options": []
		},
		"java": {
			"profile": "pattern-partial",
			"options": ["pad", "obfuscate"]
		},
		"python": {
			"profile": "strict-or-null",
			"knownDeviations": [
				{
					"inputs": ["１２３４５６７８９０９", "١٢٣٤٥٦٧٨٩٠٩"],
					"reason": "format_cpf delegates to is_valid, so it inherits the Unicode digit deviation and returns a CPF formatted in non ASCII digits."
				}
			]
		},
		"ruby": {
			"profile": "strict-or-null"
		},
		"rust": {
			"profile": "strict-or-null"
		}
	},
	"profiles": {
		"pattern-partial": {
			"description": "Sanitizes to digits and lays them over the pattern, emitting a separator only while digits are left, so a short value formats to a partial mask instead of failing.",
			"absent": "empty-string",
			"pipeline": [
				{
					"op": "sanitize",
					"keep": "ascii-digits",
					"into": "digits"
				},
				{
					"op": "apply-pattern",
					"target": "digits",
					"engine": "pattern-v1",
					"pattern": "000.000.000-00",
					"variants": {
						"obfuscate": "***.000.000-**"
					}
				}
			],
			"options": [
				{
					"name": "pad",
					"type": "boolean",
					"default": false,
					"read": "truthy"
				},
				{
					"name": "obfuscate",
					"type": "boolean",
					"default": false,
					"read": "truthy"
				}
			]
		},
		"strict-or-null": {
			"description": "Returns the empty value unless the input is already a valid CPF. Implemented by the Python, Ruby and Rust packages, which return None/nil.",
			"absent": "null",
			"pipeline": [
				{
					"op": "guard-valid",
					"utility": "is-valid-cpf",
					"profile": "digits-only"
				},
				{
					"op": "sanitize",
					"keep": "ascii-digits",
					"into": "digits"
				},
				{
					"op": "apply-pattern",
					"target": "digits",
					"engine": "pattern-v1",
					"pattern": "000.000.000-00"
				}
			],
			"options": []
		}
	}
}
