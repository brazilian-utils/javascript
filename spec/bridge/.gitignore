# Everything under `out/` is generated by `compiler/cli.ts`, and every build tree the targets
# leave behind is generated by their own toolchains.
out/
node_modules/

# The conformance recordings are taken from the package this repository ships, by
# `conformance/vectors.ts` and `conformance/municipalities.ts`, which `run-all.sh` runs first.
# `source/*.data.json` is committed: it is an input to the compiler, not a recording.
conformance/vectors.json
conformance/vectors.tsv
conformance/municipalities.expected.txt
conformance/municipalities.keys.txt
conformance/cep.expected.tsv
