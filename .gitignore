dist
coverage
.stryker-tmp
# Nothing in the project reads one, so a local `.env` never has a reason to be committed.
.env
.env.*
# The SBOM is generated by the release workflow right before publishing.
*.cdx.json
# Every report is generated (stryker, coverage, jscpd) except the API Extractor baseline, which is
# committed so that `npm run check:api` compares the public API against the reviewed one instead of
# writing a new file on every run.
reports/*
!reports/api/
reports/api/*
!reports/api/brazilian-utils.api.md
spec/generated

# The benchmark harness builds its artifacts from source; `spec/bench/run-all.sh` recreates them.
spec/bench/.build
spec/bench/.spec-masked-strict
spec/bench/**/target
spec/bench/harness/go/generated
spec/bench/harness/java/Cpf.java
spec/bench/harness/java/SpecRuntime.java
spec/bench/harness/csharp/bin
spec/bench/harness/csharp/obj
