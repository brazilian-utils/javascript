dist
coverage
.stryker-tmp
# Nothing in the project reads one, so a local `.env` never has a reason to be committed.
.env
.env.*
# The SBOM is generated by the release workflow right before publishing.
*.cdx.json
# Generated reports (Stryker writes its mutation reports there).
reports
# Deno writes a lockfile next to jsr.json on every `deno test`/`deno publish`; the npm lockfile is
# the one that pins this project's dependencies.
deno.lock

# The examples the guides show are generated from templates by `npm run build:examples` (the docs
# site, brazilian-utils/docs, runs it before reading `docs/`): only what a person writes is kept here.
docs/snippets/document-field/generated/
docs/snippets/address-form/*/cep-field.*
docs/snippets/address-form/*/field.*
docs/snippets/address-form/react/use-mask.ts
docs/snippets/address-form/vue/mask.ts
docs/snippets/address-form/angular/mask.directive.ts
