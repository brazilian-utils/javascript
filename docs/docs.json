{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "mint",
	"name": "Brazilian Utils",
	"description": "Zero-dependency, tree-shakeable utils for Brazilian-specific businesses: CPF, CNPJ, boleto, Pix, CEP, holidays and more.",
	"colors": {
		"primary": "#009739"
	},
	"logo": {
		"light": "/images/logo.png",
		"dark": "/images/logo.png",
		"href": "https://brazilian-utils.com.br"
	},
	"favicon": "/images/favicon.png",
	"appearance": {
		"default": "dark"
	},
	"navigation": {
		"languages": [
			{
				"language": "en",
				"default": true,
				"groups": [
					{
						"group": "Guide",
						"pages": ["getting-started", "utilities", "migration-v1-to-v2"]
					}
				]
			},
			{
				"language": "pt-BR",
				"groups": [
					{
						"group": "Guia",
						"pages": ["pt-br/getting-started", "pt-br/utilities", "pt-br/migration-v1-to-v2"]
					}
				]
			}
		]
	},
	"navbar": {
		"links": [
			{
				"label": "npm",
				"href": "https://www.npmjs.com/package/@brazilian-utils/brazilian-utils"
			}
		],
		"primary": {
			"type": "github",
			"href": "https://github.com/brazilian-utils/javascript"
		}
	},
	"footer": {
		"socials": {
			"github": "https://github.com/brazilian-utils",
			"website": "https://brazilian-utils.com.br"
		}
	},
	"contextual": {
		"options": ["copy", "view", "chatgpt", "claude"]
	},
	"feedback": {
		"thumbs": true,
		"edits": true,
		"issues": true
	},
	"seo": {
		"indexing": "navigable",
		"metatags": {
			"og:site_name": "Brazilian Utils"
		},
		"organization": {
			"name": "Brazilian Utils",
			"url": "https://brazilian-utils.com.br",
			"sameAs": [
				"https://github.com/brazilian-utils",
				"https://www.npmjs.com/package/@brazilian-utils/brazilian-utils"
			]
		}
	}
}
